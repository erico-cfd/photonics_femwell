kappa_0 = np.exp(ln_k0)                                                       # rad/um at g = 0
print("supermode kappa_z(g): " + ", ".join(f"{g:.0f} nm -> {k:.4f} rad/um" for g, k in zip(gaps_nm, kz)))
print(f"fit kappa_z = {kappa_0:.3f} exp(-g/{1e3/gamma_g:.0f} nm)   (decay length {1e3/gamma_g:.0f} nm)")



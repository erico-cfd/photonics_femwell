def K_power(gap_nm, L_um):
    """Power coupling |kappa|^2 from CHROST15 Eq. 4.8: |kappa|^2 = sin^2(k_z*L),
       k_z = pi*Delta_n/lambda from the supermode fit."""
    k_z = kappa_0 * np.exp(-gamma_g * gap_nm * 1e-3)   # = pi*Delta_n/lambda  [rad/um]
    return np.sin(k_z * L_um) ** 2, L_um



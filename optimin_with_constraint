def r1_from_fsr(fsr_ghz):
    """R1 (um) giving a target FSR (GHz):  FSR = c / (n_g * 2 pi R)."""
    return c / (n_g(pump_nm) * 2 * np.pi * fsr_ghz * 1e9) * 1e6


def A_bend(r1_um):
    """Rough bend-loss add-on (dB/cm): ~0 for large R, rises for small R.

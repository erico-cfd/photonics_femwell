print(f"beta2 = {beta2(pump_nm):.3e} s^2/m   D = {D_ps_nm_km(pump_nm):+.0f} ps/(nm km) "
      f"({'ANOMALOUS' if D_ps_nm_km(pump_nm) > 0 else 'normal'} dispersion)")
print("  -> anomalous GVD (D>0, beta2<0) is favourable for SFWM [AGRAWAL13 sec 10.2].")
print("  [Friday: aim for D slightly positive / dispersion close to zero -> sweep width.]")

# Phase matching Delta_k = k_s + k_i - 2 k_p, omega_s,i = omega_p +/- Delta_Omega
